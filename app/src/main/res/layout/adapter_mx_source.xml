<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_mx_source_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/type"
        android:layout_width="52dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/mx_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:background="@drawable/shape_mx_type_vod"
        tools:text="点播" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="饭太硬" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/current"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/shape_mx_badge_current"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:text="@string/mx_source_badge_current"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/probe"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="14dp"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/white_60"
        android:textSize="15sp"
        tools:background="@drawable/shape_mx_probe_ok"
        tools:text="856ms" />

</androidx.appcompat.widget.LinearLayoutCompat>
